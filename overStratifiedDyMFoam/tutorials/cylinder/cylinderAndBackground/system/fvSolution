FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    cellDisplacement
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0;
        maxIter         100;
    }
    p_rgh
    {
       solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0;
    };
    p
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0;
    }


    pFinal
    {
        $p;
        relTol          0;
    }
    p_rghFinal
    {
        $p;
        relTol          0;
    }

    pcorr
    {
        $pFinal;
        solver          PCG;
        preconditioner  DIC;
    }

    pcorrFinal
    {
        $pcorr;
        relTol          0;
    }

    "(U|k|epsilon|omega|T|S)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0;
    }

    "(U|k|epsilon|omega|T|S)Final"
    {
        $U;
        tolerance       1e-6;
        relTol          0;
    }
}


PIMPLE
{
    momentumPredictor   yes;

    nOuterCorrectors    5;
    nCorrectors         3;
    nNonOrthogonalCorrectors 1;

    maxCo               0.5;
    maxAlphaCo          1;

    rDeltaTSmoothingCoeff 0.1;
    rDeltaTDampingCoeff 0.2;
    nAlphaSpreadIter    0;
    nAlphaSweepIter     0;
    maxDeltaT           0.1;
    pRefCell    0; 
    pRefValue   0;
    correctPhi          yes; 
}

relaxationFactors
{
    fields
    {
    }
    equations
    {
        ".*"           1;
    }
}


