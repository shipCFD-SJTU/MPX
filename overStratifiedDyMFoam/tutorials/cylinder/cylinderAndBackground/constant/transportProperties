FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel Newtonian;

// Laminar viscosity
nu              7.28e-7;


betaT           2e-04;

betaS           7e-04;

TRef            300;

Pr              7;

Prt             0.85;

SRef		100;

Sc	        700;

Sct             0.7;



rhoRef		1000;

