FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;//湍流运动粘度，不影响
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-05;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
    }

    sphere
    {
        type            nutkWallFunction;
        value           $internalField;
    }

    top
    {
        type            fixedValue;
        value           $internalField;	
    }

    bottom
    {
	type            fixedValue;
        value           $internalField;	
    }

   "(side1|side2)"
    {
        type            symmetry;
    }
}


