FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;//湍流耗散率，不重要
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 2.0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue	$internalField;
        value           $internalField;
    }

    top
    {
	type            fixedValue;
        value           $internalField;
    }

    bottom
    {
	type            fixedValue;
        value           $internalField;
    }
    
    sphere
    {
        type            omegaWallFunction;
        value           $internalField;
    }

    "(side1|side2)"
    {
        type            symmetry;
    }
}


