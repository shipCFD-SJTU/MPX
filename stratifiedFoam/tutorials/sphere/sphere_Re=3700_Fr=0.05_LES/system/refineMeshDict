FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      refineMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Cells to refine; name of cell set
set crefine;


coordinateSystem global;

globalCoeffs
{
    tan1 (1 0 0);
    tan2 (0 0 1);
}



directions    (tan1 tan2 normal);




useHexTopology  true;

geometricCut    false;


writeMesh       false;

