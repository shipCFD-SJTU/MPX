FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      kappaS;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-7;

boundaryField
{
    inlet
    {
    	type            zeroGradient;
    }
    outlet
    {
    	type            zeroGradient;
    }
    "(bottom|top)"
    {
    	type            zeroGradient;
    }
   "(side1|side2)"
    {
        type            symmetry;
    }
    sphere
    {
    	type		zeroGradient;
    	
    }

}


